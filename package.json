{
  "name": "@rifts_to/mcp",
  "version": "0.4.0",
  "description": "rifts.to MCP server. Create live audience surveys and read their results from an AI client.",
  "license": "Apache-2.0",
  "author": "RIFTS TO, LLC",
  "homepage": "https://rifts.to",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riftsto/mcp.git"
  },
  "type": "module",
  "bin": {
    "rifts-mcp": "dist/stdio.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "rifts.to",
    "survey",
    "poll"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "bugs": {
    "url": "https://github.com/riftsto/mcp/issues"
  }
}
